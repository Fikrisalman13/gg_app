<script>
$(function () {
    var selected = <?= json_encode($selectedPrs, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    function syncFromInput() {
        var current = selected;
        selected = {};
        $('#prnumbers').val().split(/[\s,]+/).forEach(function (number) { number = $.trim(number).toUpperCase(); if (number) selected[number] = current[number] || { no_pr: number }; });
        render();
    }
    function render() {
        var numbers = Object.keys(selected).sort();
        $('#selectedPrCount').text(numbers.length + ' PR dipilih');
        if (!numbers.length) { $('#selectedPrList').html('<small class="text-muted">Belum ada PR dipilih.</small>'); return; }
        var html = '';
        numbers.forEach(function (number) {
            var escaped = $('<div>').text(number).html();
            html += '<span class="badge badge-light border mr-1 mb-1 p-2">' + escaped + ' <button type="button" class="btn btn-xs btn-link text-danger p-0 ml-1 remove-pr" data-number="' + escaped + '"><i class="fas fa-times"></i></button></span>';
        });
        $('#selectedPrList').html(html);
    }
    function writeInput() { $('#prnumbers').val(Object.keys(selected).sort().join('\n')); render(); refreshChecks(); }
    function refreshChecks() { if ($.fn.DataTable.isDataTable('#prLookupTable')) prTable.rows().invalidate().draw(false); }
    $('#prnumbers').on('input', syncFromInput); syncFromInput();
    $('.priceTable').each(function () {
        var $table = $(this);
        if ($table.find('tbody td[colspan]').length) return;
        $table.DataTable({ responsive: false, autoWidth: false, pageLength: 25, order: [], language: { lengthMenu: 'Tampilkan _MENU_ data per halaman', zeroRecords: 'Tidak ada data ditemukan', info: 'Menampilkan _START_ - _END_ dari _TOTAL_ data', infoEmpty: 'Tidak ada data tersedia', search: 'Cari:', paginate: { first: 'Pertama', last: 'Terakhir', next: 'Selanjutnya', previous: 'Sebelumnya' } } });
    });
    var prTable = $('#prLookupTable').DataTable({ serverSide: true, processing: true, ajax: { url: 'cekhargabypr.php', type: 'GET', data: function (d) { d.ajax = 'prs'; } }, columns: [
        { data: null, orderable: false, searchable: false, className: 'text-center', render: function (data, type, row) { var number = String(row.no_pr); return '<input type="checkbox" class="pr-check" value="' + $('<div>').text(number).html() + '" ' + (selected[number] ? 'checked' : '') + '>'; } },
        { data: 'no_pr' }
    ], pageLength: 10, order: [[1, 'asc']], language: { processing: 'Memproses...', lengthMenu: 'Tampilkan _MENU_ PR per halaman', zeroRecords: 'PR tidak ditemukan', info: 'Menampilkan _START_ - _END_ dari _TOTAL_ PR', infoEmpty: 'Tidak ada PR tersedia', search: 'Cari No PR:', paginate: { first: 'Pertama', last: 'Terakhir', next: 'Selanjutnya', previous: 'Sebelumnya' } } });
    $('#prLookupTable').on('change', '.pr-check', function () { var row = prTable.row($(this).closest('tr')).data(); var number = String(row.no_pr); if (this.checked) selected[number] = { pr_id: String(row.pr_id), no_pr: number }; else delete selected[number]; render(); $('#checkAllFilteredPrs').prop('checked', false); });
    $('#checkAllFilteredPrs').on('change', function () { var check = this.checked, $box = $(this); $box.prop('disabled', true); $.getJSON('cekhargabypr.php', { ajax: 'filtered_prs', search_value: prTable.search() }).done(function (res) { if (!res.success) { alert(res.error || 'Gagal mengambil data PR.'); $box.prop('checked', false); return; } res.data.forEach(function (pr) { var number = String(pr.no_pr); if (check) selected[number] = { pr_id: String(pr.pr_id), no_pr: number }; else delete selected[number]; }); writeInput(); }).fail(function () { alert('Gagal mengambil data PR.'); $box.prop('checked', false); }).always(function () { $box.prop('disabled', false); }); });
    $('#prModal').on('shown.bs.modal', function () { prTable.columns.adjust(); });
    $('#savePrs').on('click', function () { writeInput(); $('#prModal').modal('hide'); });
    $('#selectedPrList').on('click', '.remove-pr', function () { delete selected[String($(this).data('number'))]; writeInput(); });
    $('#clearSelectedPrs').on('click', function () { selected = {}; writeInput(); $('#checkAllFilteredPrs').prop('checked', false); });
});
</script>
