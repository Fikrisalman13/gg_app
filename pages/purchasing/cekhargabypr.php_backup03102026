function jsonResponse(array $data): void
{
    header('Content-Type: application/json; charset=UTF-8');
    echo json_encode($data);
    exit;
}

if (isset($_GET['ajax']) && in_array($_GET['ajax'], ['prs', 'filtered_prs'], true)) {
    if (!isset($_SESSION['UserName'])) {
        jsonResponse(['draw' => (int) ($_GET['draw'] ?? 0), 'recordsTotal' => 0, 'recordsFiltered' => 0, 'data' => [], 'success' => false, 'error' => 'Silakan login terlebih dahulu!']);
    }
    if (!$conn3) {
        jsonResponse(['draw' => (int) ($_GET['draw'] ?? 0), 'recordsTotal' => 0, 'recordsFiltered' => 0, 'data' => [], 'success' => false, 'error' => 'Koneksi ke database gagal.']);
    }

    $search = trim((string) ($_GET['search']['value'] ?? $_GET['search_value'] ?? ''));
    $where = "WHERE h.fgstatus IN ('V', 'U', 'X')";
    $params = [];
    if ($search !== '') {
        $where .= ' AND h.ppnmbr ILIKE :search';
        $params[':search'] = '%' . $search . '%';
    }
    if ($_GET['ajax'] === 'filtered_prs') {
        $stmt = $conn3->prepare("SELECT h.pphdid AS pr_id, h.ppnmbr AS no_pr FROM prpphd h $where ORDER BY h.ppnmbr");
        foreach ($params as $key => $value) $stmt->bindValue($key, $value);
        $stmt->execute();
        jsonResponse(['success' => true, 'data' => $stmt->fetchAll(PDO::FETCH_ASSOC)]);
    }

    $draw = (int) ($_GET['draw'] ?? 0);
    $start = max(0, (int) ($_GET['start'] ?? 0));
    $length = (int) ($_GET['length'] ?? 10);
    $length = $length > 0 ? min($length, 100) : 10;
    $total = (int) $conn3->query("SELECT COUNT(*) FROM prpphd WHERE fgstatus IN ('V', 'U', 'X')")->fetchColumn();
    $count = $conn3->prepare("SELECT COUNT(*) FROM prpphd h $where");
    foreach ($params as $key => $value) $count->bindValue($key, $value);
    $count->execute();
    $filtered = (int) $count->fetchColumn();
    $stmt = $conn3->prepare("SELECT h.pphdid AS pr_id, h.ppnmbr AS no_pr FROM prpphd h $where ORDER BY h.ppnmbr LIMIT :length OFFSET :start");
    foreach ($params as $key => $value) $stmt->bindValue($key, $value);
    $stmt->bindValue(':length', $length, PDO::PARAM_INT);
    $stmt->bindValue(':start', $start, PDO::PARAM_INT);
    $stmt->execute();
    jsonResponse(['draw' => $draw, 'recordsTotal' => $total, 'recordsFiltered' => $filtered, 'data' => $stmt->fetchAll(PDO::FETCH_ASSOC)]);
}

