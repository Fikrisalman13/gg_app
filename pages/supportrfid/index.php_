<?php
session_start();

// 🔐 Cek login
if (!isset($_SESSION['username'])) {
    header('Location: login.php');
    exit;
}

$username = $_SESSION['username'] ?? 'Guest';
$role = $_SESSION['role'] ?? '';
?>

<!DOCTYPE html>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
